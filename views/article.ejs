<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Article — Muhammad Julda Al Hafiz</title><meta name="description" content="Muhammad Julda Al Hafiz — Human Resources"><link rel="stylesheet" href="/style.css"></head><body><%- include('partials/navbar') %><main><article class="hero"><div class="container"><div class="kicker"><%= article.category||"Article" %> · <%= article.published_at ? new Date(article.published_at).toLocaleDateString("id-ID") : "" %></div><h1><%= article.title %></h1><p class="lead"><%= article.excerpt||"" %></p><% if(article.cover){ %><img class="article-cover" src="/uploads/<%= article.cover %>" alt="<%= article.title %>"><% } %><div class="article-body"><%- (article.content||"").split(/\n{2,}/).map(x=>`<p>${x.replace(/\n/g,"<br>")}</p>`).join("") %></div><p class="muted">Ditulis oleh <strong><%= profile.name %></strong></p></div></article><script type="application/ld+json"><%- JSON.stringify({"@context":"https://schema.org","@type":"Article","headline":article.title,"description":article.excerpt||"","datePublished":article.published_at,"dateModified":article.updated_at,"author":{"@type":"Person","name":profile.name,"url":siteUrl},"mainEntityOfPage":siteUrl+"/articles/"+article.slug,"url":siteUrl+"/articles/"+article.slug}) %></script></main><footer class="footer"><div class="container"><strong>Muhammad Julda Al Hafiz</strong><br>Human Resources · From Numbers to Human Impact.</div></footer></body></html>