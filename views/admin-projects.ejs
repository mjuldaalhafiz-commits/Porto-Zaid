<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Manage Projects — Admin CMS</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="admin-body">
  <div class="admin-shell">
    <aside class="admin-side">
      <h2>Admin CMS</h2>
      <p>Muhammad Julda Al Hafiz</p>
      <a href="/admin">Dashboard</a>
      <a href="/admin/profile">Profile & CV</a>
      <a href="/admin/articles">Articles</a>
      <a href="/admin/projects" style="background:rgba(255,255,255,0.12);color:#fff;font-weight:700;">Projects</a>
      <a href="/admin/experience">Experience</a>
      <a href="/admin/certifications">Certifications</a>
      <a href="/admin/education">Education</a>
      <a href="/" target="_blank">View Public Website ↗</a>
      <form method="post" action="/admin/logout">
        <button class="small-btn">Logout</button>
      </form>
    </aside>

    <main class="admin-main">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;flex-wrap:wrap;gap:12px;">
        <div>
          <h1 style="margin:0;">Project Showcases</h1>
          <p class="muted" style="margin:4px 0 0;">Kelola 10 studi kasus, bukti kerja visual (evidence), dokumen PDF, dan visibilitas publik.</p>
        </div>
        <a class="btn primary" href="/admin/projects/new">+ Add New Project</a>
      </div>

      <div class="admin-card" style="padding:0;overflow:hidden;">
        <table>
          <thead>
            <tr>
              <th style="width:70px;">Cover</th>
              <th>Title / Slug</th>
              <th>Category</th>
              <th>Status</th>
              <th style="width:60px;text-align:center;">Order</th>
              <th style="width:90px;text-align:center;">Visibility</th>
              <th style="width:160px;text-align:right;">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% projects.forEach(p => { %>
              <tr>
                <td>
                  <% if (p.cover) { %>
                    <img src="/uploads/<%= p.cover %>" alt="" style="width:60px;height:38px;object-fit:cover;border-radius:3px;border:1px solid var(--line);">
                  <% } else { %>
                    <span style="font-size:11px;color:#aaa;">No cover</span>
                  <% } %>
                </td>
                <td>
                  <strong><%= p.title %></strong>
                  <br>
                  <a href="/projects/<%= p.slug %>" target="_blank" style="font-size:12px;color:var(--accent);">
                    /projects/<%= p.slug %> ↗
                  </a>
                </td>
                <td>
                  <span style="font-size:12px;background:#f5f4ef;padding:3px 8px;border-radius:4px;border:1px solid #e5e3db;">
                    <%= p.category || p.type || 'General' %>
                  </span>
                </td>
                <td style="font-size:13px;color:#555;">
                  <%= p.status || '-' %>
                </td>
                <td style="text-align:center;font-weight:700;">
                  <%= p.display_order || 0 %>
                </td>
                <td style="text-align:center;">
                  <% if (p.is_public == 1 || p.is_public === null) { %>
                    <span style="font-size:11px;font-weight:700;color:#166534;background:#dcfce7;padding:3px 8px;border-radius:12px;">Public</span>
                  <% } else { %>
                    <span style="font-size:11px;font-weight:700;color:#854d0e;background:#fef9c3;padding:3px 8px;border-radius:12px;">Draft / Hidden</span>
                  <% } %>
                </td>
                <td style="text-align:right;">
                  <a class="small-btn" href="/admin/projects/<%= p.id %>/edit">Edit</a>
                  <form style="display:inline;" method="post" action="/admin/projects/<%= p.id %>/delete" onsubmit="return confirm('Apakah Anda yakin ingin menghapus project ini?');">
                    <button class="small-btn danger">Delete</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </main>
  </div>
</body>
</html>