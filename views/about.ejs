<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>About — <%= typeof profile !== 'undefined' && profile?.name ? profile.name : 'Muhammad Julda Al Hafiz' %></title>
  <meta name="description" content="<%= typeof profile !== 'undefined' && profile?.name ? profile.name : 'Muhammad Julda Al Hafiz' %> — <%= typeof profile !== 'undefined' && profile?.field ? profile.field : 'HR Generalist' %>">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <%- include('partials/navbar') %>

  <main>
    <section class="hero">
      <div class="container" style="display:flex;align-items:center;justify-content:space-between;gap:36px;flex-wrap:wrap;">
        <div style="flex:1 1 540px;">
          <div class="kicker">About Me</div>
          <h1><%= typeof profile !== 'undefined' && profile?.name ? profile.name : 'Muhammad Julda Al Hafiz' %></h1>
          <p class="lead" style="font-weight:600;color:#222;">
            <%= typeof profile !== 'undefined' && profile?.field ? profile.field : 'HR Generalist | Recruitment · Payroll · HR Operations · HRGA' %>
          </p>
          <div class="muted" style="font-size:16px;line-height:1.75;margin-bottom:20px;">
            <%- ((typeof profile !== 'undefined' && profile?.bio) ? profile.bio : 'HR Generalist bersertifikat BNSP dengan pengalaman membangun dan menstandarkan fondasi HR.').split(/\n+/).map(p => `<p style="margin-bottom:12px;">${p}</p>`).join('') %>
          </div>
          <div class="actions">
            <a class="btn primary" href="/experience">Lihat Pengalaman Kerja</a>
            <a class="btn" href="/contact">Hubungi Saya</a>
            <% if (typeof profile !== 'undefined' && profile?.show_cv == 1 && profile?.cv_file) { %>
              <a class="btn" href="/cv">Curriculum Vitae</a>
            <% } %>
          </div>
        </div>

        <% if (typeof profile !== 'undefined' && profile?.photo) { %>
          <div style="flex:0 0 auto;">
            <div style="width:220px;height:220px;border-radius:50%;overflow:hidden;border:4px solid var(--accent);box-shadow:0 8px 24px rgba(0,0,0,0.12);background:#fff;">
              <img src="/uploads/<%= profile.photo %>" alt="<%= profile.name %>" style="width:100%;height:100%;object-fit:cover;">
            </div>
          </div>
        <% } %>
      </div>
    </section>

    <!-- Highlights Section -->
    <section class="section">
      <div class="container">
        <div class="kicker">Highlights</div>
        <h2>Pencapaian Utama</h2>
        <div class="grid">
          <div class="card">
            <div class="meta">Recruitment</div>
            <h3>45+ Posisi Terisi</h3>
            <p>Mengisi 45+ posisi melalui proses rekrutmen end-to-end mandiri, dengan rata-rata pemenuhan 14 hari kerja (posisi produksi) dan 20 hari kerja (posisi office).</p>
          </div>
          <div class="card">
            <div class="meta">Payroll & Ops</div>
            <h3>Sistem Payroll 100+ Karyawan</h3>
            <p>Membangun sistem payroll berbasis Excel dengan cut-off tetap dan integrasi data absensi digital, lembur, serta potongan bebas human error.</p>
          </div>
          <div class="card">
            <div class="meta">Governance</div>
            <h3>10+ SOP & Regulasi Kerja</h3>
            <p>Menyusun 10+ SOP, kebijakan perusahaan, regulasi disiplin, dan standarisasi perjanjian kerja PKWT/PKWTT tertulis untuk kepatuhan hukum.</p>
          </div>
          <div class="card">
            <div class="meta">Organization</div>
            <h3>Job Desc & Analisis Jabatan</h3>
            <p>Membangun fondasi administrasi melalui struktur organisasi, uraian jabatan resmi, dan dokumentasi aset kantor terpusat.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Core Competencies Section -->
    <section class="section">
      <div class="container">
        <div class="kicker">Core Competencies</div>
        <h2>Keahlian & Kompetensi Teknis</h2>
        <div class="grid">
          <div class="card">
            <div class="meta">Talent Acquisition</div>
            <h3>Recruitment</h3>
            <p>End-to-End Recruitment, Manpower Planning, Job Analysis, Sourcing, Screening, Interview Coordination, Onboarding & Offboarding, Candidate Database.</p>
          </div>
          <div class="card">
            <div class="meta">HR Operations</div>
            <h3>Operations & Payroll</h3>
            <p>Payroll Administration, Attendance Management, Employee Database, PKWT/PKWTT Administration, BPJS Ketenagakerjaan & Kesehatan (Basic).</p>
          </div>
          <div class="card">
            <div class="meta">Compliance</div>
            <h3>HR Governance</h3>
            <p>SOP Development, HR Documentation, Company Policy, Employment Regulations, Employee Relations, Job Description, Organizational Structure, Process Standardization.</p>
          </div>
          <div class="card">
            <div class="meta">Facilities</div>
            <h3>General Affairs</h3>
            <p>Asset Administration, Vendor Coordination, Facility & Office Management, Office Procurement.</p>
          </div>
          <div class="card">
            <div class="meta">Technical</div>
            <h3>Tools & Systems</h3>
            <p>Microsoft Office (Excel Advanced Formula), Google Workspace, Excel-based Payroll System, HRIS Functional Requirements Design.</p>
          </div>
          <div class="card">
            <div class="meta">Credentials</div>
            <h3>Sertifikasi BNSP</h3>
            <p>BNSP HR Staff (LSP Manajemen & Pengembangan SDM) & BNSP Staf Administrasi Pelatihan & Pengembangan (LSP Ubhara).</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container">
      <strong><%= typeof profile !== 'undefined' && profile?.name ? profile.name : 'Muhammad Julda Al Hafiz' %></strong><br>
      HR Generalist · <%= typeof profile !== 'undefined' && profile?.tagline ? profile.tagline : 'From Numbers to Human Impact.' %>
    </div>
  </footer>
</body>
</html>
