<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Media & File Library — Admin CMS</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="admin-body">
  <div class="admin-shell">
    <%- include('partials/admin-sidebar', { active: 'media' }) %>

    <main class="admin-main">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;flex-wrap:wrap;gap:12px;">
        <div>
          <h1 style="margin:0;">Media & File Library</h1>
          <p class="muted" style="margin:4px 0 0;">Pusat pengelolaan file: upload dokumen, bukti visual, pratinjau, copy URL, dan penghapusan aman.</p>
        </div>
        <a class="btn primary" href="#upload-box">+ Upload Berkas Baru</a>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="notice" style="background:#fee2e2;color:#991b1b;border-color:#f87171;margin-bottom:20px;">
          ⚠️ <strong>Gagal:</strong> <%= error %>
        </div>
      <% } %>
      <% if (typeof success !== 'undefined' && success) { %>
        <div class="notice" style="background:#dcfce7;color:#166534;border-color:#86efac;margin-bottom:20px;">
          ✅ <%= success %>
        </div>
      <% } %>

      <!-- Upload Form Card -->
      <div class="admin-card" id="upload-box" style="margin-bottom:28px;">
        <h2 style="font-size:18px;margin-bottom:12px;">📤 Upload Berkas ke Media Library</h2>
        <form method="post" action="/admin/media/upload" enctype="multipart/form-data" style="display:flex;gap:16px;align-items:flex-end;flex-wrap:wrap;">
          <div style="flex-grow:1;min-width:280px;">
            <label style="margin-top:0;">Pilih Berkas (Gambar JPG/PNG/WebP atau Dokumen PDF, Maks 15MB)</label>
            <input type="file" name="media" required accept=".pdf,image/*">
          </div>
          <div>
            <label style="margin-top:0;">Akses Berkas</label>
            <select name="is_private">
              <option value="0" selected>Public (Bisa Diakses Pengunjung)</option>
              <option value="1">Private (Hanya Internal Admin)</option>
            </select>
          </div>
          <button class="btn primary" style="padding:11px 22px;">Upload Sekarang</button>
        </form>
      </div>

      <!-- Search & Filter Bar -->
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;flex-wrap:wrap;gap:12px;">
        <input type="text" id="mediaSearch" placeholder="🔍 Cari nama file atau ekstensi..." oninput="filterMedia()" style="max-width:360px;padding:9px 14px;">
        <span class="muted" style="font-size:13px;">Total: <strong><%= files.length %></strong> file tersimpan</span>
      </div>

      <!-- Media Files Table -->
      <div class="admin-card" style="padding:0;overflow:hidden;">
        <table>
          <thead>
            <tr>
              <th style="width:70px;text-align:center;">Preview</th>
              <th>Nama File & URL</th>
              <th>Tipe MIME</th>
              <th>Ukuran</th>
              <th>Tanggal Upload</th>
              <th style="width:160px;text-align:right;">Aksi</th>
            </tr>
          </thead>
          <tbody id="mediaTableBody">
            <% files.forEach(f => { %>
              <tr class="media-row" data-name="<%= (f.filename + ' ' + (f.original_name || '')).toLowerCase() %>">
                <td style="text-align:center;">
                  <% if (f.mime_type && f.mime_type.startsWith('image/')) { %>
                    <img src="/uploads/<%= f.filename %>" alt="" style="width:50px;height:35px;object-fit:cover;border-radius:3px;border:1px solid var(--line);">
                  <% } else if (f.filename.endsWith('.pdf')) { %>
                    <span style="font-size:24px;">📄</span>
                  <% } else { %>
                    <span style="font-size:24px;">📁</span>
                  <% } %>
                </td>
                <td>
                  <strong><%= f.original_name || f.filename %></strong>
                  <br>
                  <code style="font-size:11px;color:var(--muted);background:#f2f1ed;padding:2px 6px;border-radius:3px;">
                    /uploads/<%= f.filename %>
                  </code>
                </td>
                <td style="font-size:12.5px;color:var(--muted);"><%= f.mime_type || '-' %></td>
                <td style="font-size:12.5px;color:var(--muted);">
                  <%= (f.file_size ? (f.file_size / 1024).toFixed(1) + ' KB' : '-') %>
                </td>
                <td style="font-size:12.5px;color:var(--muted);">
                  <%= f.uploaded_at ? new Date(f.uploaded_at).toLocaleDateString('id-ID') : '-' %>
                </td>
                <td style="text-align:right;">
                  <button type="button" class="small-btn" onclick="copyUrl('/uploads/<%= f.filename %>')">Copy URL</button>
                  <a class="small-btn" href="/uploads/<%= f.filename %>" target="_blank">View</a>
                  <form style="display:inline;" method="post" action="/admin/media/delete" onsubmit="return confirm('Apakah Anda yakin ingin menghapus file ini? Penghapusan akan ditolak jika file masih dipakai oleh konten lain.');">
                    <input type="hidden" name="filename" value="<%= f.filename %>">
                    <button class="small-btn danger">Delete</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </main>
  </div>

  <script>
    function copyUrl(path) {
      const fullUrl = window.location.origin + path;
      navigator.clipboard.writeText(fullUrl).then(() => {
        alert('URL berhasil disalin ke clipboard:\n' + fullUrl);
      }).catch(() => {
        prompt('Salin URL berikut:', fullUrl);
      });
    }

    function filterMedia() {
      const q = document.getElementById('mediaSearch').value.toLowerCase();
      const rows = document.querySelectorAll('.media-row');
      rows.forEach(r => {
        const name = r.getAttribute('data-name');
        r.style.display = name.includes(q) ? '' : 'none';
      });
    }
  </script>
</body>
</html>
