<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Certifications — Muhammad Julda Al Hafiz</title><meta name="description" content="Muhammad Julda Al Hafiz — Human Resources"><link rel="stylesheet" href="/style.css"></head><body><%- include('partials/navbar') %><main><section class="hero"><div class="container"><div class="kicker">Certifications</div><h1>Certifications & training.</h1><div class="grid"><% certifications.forEach(c=>{ %><article class="card"><div class="meta"><%= c.year||"" %></div><h3><%= c.title %></h3><p class="muted"><%= c.issuer||"" %></p><% if(c.file){ %><a class="small-btn" href="/uploads/<%= c.file %>" target="_blank">View File →</a><% } %></article><% }) %></div></div></section></main><footer class="footer"><div class="container"><strong>Muhammad Julda Al Hafiz</strong><br>Human Resources · From Numbers to Human Impact.</div></footer></body></html>