<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= typeof siteSettings !== 'undefined' && siteSettings?.site_title ? siteSettings.site_title : (typeof profile !== 'undefined' && profile?.name ? profile.name : 'Muhammad Julda Al Hafiz') %></title>
  <meta name="description" content="<%= typeof siteSettings !== 'undefined' && siteSettings?.meta_description ? siteSettings.meta_description : 'Muhammad Julda Al Hafiz — HR Generalist' %>">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <%- include('partials/navbar') %>

  <main>
    <!-- Hero Section -->
    <% const heroSec = typeof siteSections !== 'undefined' ? siteSections['hero'] : null; %>
    <% if (!heroSec || heroSec.is_visible == 1) { %>
      <section class="hero">
        <div class="container">
          <div class="kicker">
            <%= (heroSec && heroSec.kicker) ? heroSec.kicker : (heroSec && heroSec.subtitle ? heroSec.subtitle : 'HR GENERALIST · FROM NUMBERS TO HUMAN IMPACT') %>
          </div>
          <h1>
            <%= (heroSec && heroSec.title && heroSec.title !== 'Hero & Profil Utama') ? heroSec.title : (typeof profile !== 'undefined' && profile?.name ? profile.name : 'Muhammad Julda Al Hafiz') %>
          </h1>
          <p class="lead" style="font-weight:600;color:#222;">
            <%= (heroSec && heroSec.subtitle && heroSec.subtitle !== 'Headline, Tagline, dan CTA Download CV') ? heroSec.subtitle : (typeof profile !== 'undefined' && profile?.tagline ? profile.tagline : 'From Numbers to Human Impact.') %>
          </p>
          <p class="muted" style="max-width:820px;font-size:16px;">
            <%= (heroSec && heroSec.content) ? heroSec.content : (typeof profile !== 'undefined' && profile?.bio ? profile.bio : 'HR Generalist bersertifikat BNSP dengan pengalaman membangun dan menstandarkan fondasi HR.') %>
          </p>
          <div class="actions">
            <a class="btn primary" href="/projects">Explore Project Showcases</a>
            <a class="btn" href="/experience">View Experience</a>
            <% if (typeof profile !== 'undefined' && profile?.show_cv == 1 && profile?.cv_file) { %>
              <a class="btn" href="/cv">Curriculum Vitae</a>
            <% } %>
          </div>
        </div>
      </section>
    <% } %>

    <!-- Highlights Section -->
    <% const hlSec = typeof siteSections !== 'undefined' ? siteSections['highlights'] : null; %>
    <% if (hlSec && hlSec.is_visible == 1) { %>
      <section class="section" style="background:#fcfbf9;border-bottom:1px solid var(--line);">
        <div class="container">
          <div class="kicker"><%= (hlSec && hlSec.kicker) ? hlSec.kicker : (hlSec.subtitle || 'STATISTIK & DAMPAK OPERASIONAL NYATA') %></div>
          <h2><%= hlSec.title || 'Pencapaian Utama' %></h2>
          
          <div class="grid">
            <% (typeof highlights !== 'undefined' && highlights && highlights.length > 0 ? highlights : []).forEach(item => { %>
              <div class="card">
                <div class="meta"><%= item.meta %></div>
                <h3><%= item.title %></h3>
                <p><%= item.description %></p>
              </div>
            <% }) %>
          </div>
        </div>
      </section>
    <% } %>

    <!-- Selected Project Showcases Section -->
    <% const projSec = typeof siteSections !== 'undefined' ? siteSections['projects'] : null; %>
    <% if (!projSec || projSec.is_visible == 1) { %>
      <section class="section">
        <div class="container">
          <div style="display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:24px;flex-wrap:wrap;gap:12px;">
            <div>
              <div class="kicker"><%= (projSec && projSec.kicker) ? projSec.kicker : (projSec && projSec.subtitle ? projSec.subtitle : 'CUPLIKAN STUDI KASUS & BUKTI VISUAL KERJA ASLI') %></div>
              <h2 style="margin-bottom:0;"><%= (projSec && projSec.title) ? projSec.title : 'Featured Project Showcases' %></h2>
            </div>
            <a class="btn" href="/projects">Lihat Semua 10 Project →</a>
          </div>

          <div class="grid">
            <% projects.forEach(p => { %>
              <article class="card" style="padding:0;overflow:hidden;display:flex;flex-direction:column;">
                <% if (p.cover) { %>
                  <a href="/projects/<%= p.slug %>" style="display:block;overflow:hidden;border-bottom:1px solid var(--line);background:#f2f1ed;aspect-ratio:16/9;">
                    <img src="/uploads/<%= p.cover %>" alt="<%= p.title %>" style="width:100%;height:100%;object-fit:cover;object-position:top;transition:transform 0.25s ease;" onmouseover="this.style.transform='scale(1.03)'" onmouseout="this.style.transform='scale(1)'">
                  </a>
                <% } %>
                <div style="padding:22px;display:flex;flex-direction:column;flex-grow:1;">
                  <div class="meta"><%= p.category || p.type || 'Showcase' %></div>
                  <h3 style="margin-top:2px;margin-bottom:8px;font-size:19px;line-height:1.35;">
                    <a href="/projects/<%= p.slug %>"><%= p.title %></a>
                  </h3>
                  <p class="muted" style="font-size:13.5px;line-height:1.6;margin-bottom:16px;flex-grow:1;"><%= p.summary %></p>
                  <div style="padding-top:12px;border-top:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;">
                    <a class="small-btn" href="/projects/<%= p.slug %>">Buka Showcase →</a>
                    <span style="font-size:11px;color:#888;"><%= p.status %></span>
                  </div>
                </div>
              </article>
            <% }) %>
          </div>
        </div>
      </section>
    <% } %>

    <!-- Articles Section -->
    <% const artSec = typeof siteSections !== 'undefined' ? siteSections['articles'] : null; %>
    <% if (!artSec || artSec.is_visible == 1) { %>
      <section class="section">
        <div class="container">
          <div class="kicker"><%= (artSec && artSec.kicker) ? artSec.kicker : (artSec && artSec.subtitle ? artSec.subtitle : 'TULISAN DAN ARTIKEL WAWASAN PRAKTIS HUMAN RESOURCES') %></div>
          <h2><%= (artSec && artSec.title) ? artSec.title : 'Practical Articles' %></h2>
          <div class="grid">
            <% articles.forEach(a => { %>
              <article class="card">
                <div class="meta"><%= a.category || 'HR' %></div>
                <h3><a href="/articles/<%= a.slug %>"><%= a.title %></a></h3>
                <p class="muted"><%= a.excerpt || '' %></p>
                <div style="margin-top:12px;">
                  <a class="small-btn" href="/articles/<%= a.slug %>">Baca Artikel →</a>
                </div>
              </article>
            <% }) %>
          </div>
        </div>
      </section>
    <% } %>

    <!-- CTA / Contact Banner Section -->
    <% const ctaSec = typeof siteSections !== 'undefined' ? siteSections['cta'] : null; %>
    <% if (ctaSec && ctaSec.is_visible == 1) { %>
      <section class="section" style="background:var(--accent);color:#fff;border-radius:var(--radius);margin:20px auto 40px;max-width:1160px;padding:48px 32px;text-align:center;">
        <h2 style="color:#fff;font-size:32px;margin-bottom:12px;"><%= ctaSec.title || 'Let’s Connect & Collaborate.' %></h2>
        <p style="color:rgba(255,255,255,0.9);max-width:720px;margin:0 auto 24px;font-size:17px;line-height:1.6;">
          <%= ctaSec.content || 'Terbuka untuk peluang karir Human Resources, konsultasi operasional HR/Payroll, standardisasi SOP, atau diskusi seputar People Management.' %>
        </p>
        <div style="display:flex;justify-content:center;gap:12px;flex-wrap:wrap;">
          <a class="btn" style="background:#fff;color:var(--accent);font-weight:700;" href="/contact">Hubungi Saya</a>
          <a class="btn" style="background:transparent;color:#fff;border-color:rgba(255,255,255,0.6);" href="https://wa.me/6281220754070" target="_blank">WhatsApp Langsung</a>
        </div>
      </section>
    <% } %>
  </main>

  <footer class="footer">
    <div class="container">
      <strong><%= typeof profile !== 'undefined' && profile?.name ? profile.name : 'Muhammad Julda Al Hafiz' %></strong><br>
      HR Generalist · <%= typeof profile !== 'undefined' && profile?.tagline ? profile.tagline : 'From Numbers to Human Impact.' %>
    </div>
  </footer>
</body>
</html>
