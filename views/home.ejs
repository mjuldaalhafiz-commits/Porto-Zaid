<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= typeof profile !== 'undefined' && profile?.name ? profile.name : 'Muhammad Julda Al Hafiz' %> — HR Generalist</title>
  <meta name="description" content="Muhammad Julda Al Hafiz — HR Generalist | Recruitment · Payroll · HR Operations · HRGA · DMAIC">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav class="nav">
    <div class="container nav-in">
      <a class="brand" href="/"><%= typeof profile !== 'undefined' && profile?.name ? profile.name : 'Muhammad Julda Al Hafiz' %></a>
      <button class="menu-toggle" type="button" onclick="document.querySelector('.nav-links').classList.toggle('open')">Menu ☰</button>
      <div class="nav-links">
        <a href="/">Home</a>
        <a href="/about">About</a>
        <a href="/experience">Experience</a>
        <a href="/projects">Projects</a>
        <a href="/articles">Articles</a>
        <a href="/certifications">Certifications</a>
        <a href="/contact">Contact</a>
      </div>
    </div>
  </nav>

  <main>
    <!-- Hero Section -->
    <section class="hero">
      <div class="container">
        <div class="kicker"><%= typeof profile !== 'undefined' && profile?.field ? profile.field : 'HR Generalist · Recruitment · Payroll · HR Operations · HRGA' %></div>
        <h1><%= typeof profile !== 'undefined' && profile?.name ? profile.name : 'Muhammad Julda Al Hafiz' %></h1>
        <p class="lead" style="font-weight:600;color:#222;"><%= typeof profile !== 'undefined' && profile?.tagline ? profile.tagline : 'From Numbers to Human Impact.' %></p>
        <p class="muted" style="max-width:820px;font-size:16px;">
          HR Generalist bersertifikat BNSP dengan pengalaman membangun dan menstandarkan fondasi HR: rekrutmen end-to-end (45+ posisi), payroll terintegrasi 100+ karyawan, 10+ SOP & perjanjian kerja PKWT/PKWTT, serta General Affairs dan continuous improvement (DMAIC).
        </p>
        <div class="actions">
          <a class="btn primary" href="/projects">Explore Project Showcases</a>
          <a class="btn" href="/experience">View Experience</a>
          <a class="btn" href="/cv">Download CV</a>
        </div>
      </div>
    </section>

    <!-- Selected Project Showcases Section -->
    <section class="section">
      <div class="container">
        <div style="display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:24px;flex-wrap:wrap;gap:12px;">
          <div>
            <div class="kicker">Portfolio Highlights</div>
            <h2 style="margin-bottom:0;">Featured Project Showcases</h2>
          </div>
          <a class="btn" href="/projects">Lihat Semua 10 Project →</a>
        </div>

        <div class="grid">
          <% projects.forEach(p => { %>
            <article class="card" style="padding:0;overflow:hidden;display:flex;flex-direction:column;">
              <% if (p.cover) { %>
                <a href="/projects/<%= p.slug %>" style="display:block;overflow:hidden;border-bottom:1px solid var(--line);background:#f2f1ed;aspect-ratio:16/9;">
                  <img src="/uploads/<%= p.cover %>" alt="<%= p.title %>" style="width:100%;height:100%;object-fit:cover;object-position:top;transition:transform 0.25s ease;" onmouseover="this.style.transform='scale(1.03)'" onmouseout="this.style.transform='scale(1)'">
                </a>
              <% } %>
              <div style="padding:22px;display:flex;flex-direction:column;flex-grow:1;">
                <div class="meta"><%= p.category || p.type || 'Showcase' %></div>
                <h3 style="margin-top:2px;margin-bottom:8px;font-size:19px;line-height:1.35;">
                  <a href="/projects/<%= p.slug %>"><%= p.title %></a>
                </h3>
                <p class="muted" style="font-size:13.5px;line-height:1.6;margin-bottom:16px;flex-grow:1;"><%= p.summary %></p>
                <div style="padding-top:12px;border-top:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;">
                  <a class="small-btn" href="/projects/<%= p.slug %>">Buka Showcase →</a>
                  <span style="font-size:11px;color:#888;"><%= p.status %></span>
                </div>
              </div>
            </article>
          <% }) %>
        </div>
      </div>
    </section>

    <!-- Articles Section -->
    <section class="section">
      <div class="container">
        <div class="kicker">HR Insights & Writing</div>
        <h2>Practical Articles</h2>
        <div class="grid">
          <% articles.forEach(a => { %>
            <article class="card">
              <div class="meta"><%= a.category || 'HR' %></div>
              <h3><a href="/articles/<%= a.slug %>"><%= a.title %></a></h3>
              <p class="muted"><%= a.excerpt || '' %></p>
              <div style="margin-top:12px;">
                <a class="small-btn" href="/articles/<%= a.slug %>">Baca Artikel →</a>
              </div>
            </article>
          <% }) %>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container">
      <strong><%= typeof profile !== 'undefined' && profile?.name ? profile.name : 'Muhammad Julda Al Hafiz' %></strong><br>
      HR Generalist · <%= typeof profile !== 'undefined' && profile?.tagline ? profile.tagline : 'From Numbers to Human Impact.' %>
    </div>
  </footer>
</body>
</html>