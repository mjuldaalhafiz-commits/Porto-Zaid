<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="stylesheet" href="/style.css"><title>Admin Login</title></head><body class="admin-body"><main style="max-width:460px;margin:12vh auto;padding:28px"><div class="admin-card"><h1>Admin Login</h1><% if(error){ %><div class="notice"><%= error %></div><% } %><form method="post" action="/admin/login"><label>Username</label><input name="username" required><label>Password</label><input type="password" name="password" required><button class="btn primary" style="margin-top:20px;width:100%">Login</button></form></div></main></body></html>