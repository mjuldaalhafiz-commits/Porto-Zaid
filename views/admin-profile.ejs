<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Profile & About Me — Admin CMS</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="admin-body">
  <div class="admin-shell">
    <%- include('partials/admin-sidebar', { active: 'profile' }) %>

    <main class="admin-main">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;flex-wrap:wrap;gap:12px;">
        <div>
          <h1 style="margin:0;">Profile & About Me</h1>
          <p class="muted" style="margin:4px 0 0;">Kelola biodata profesional, ringkasan profil, informasi kontak, dan berkas CV resmi.</p>
        </div>
        <a class="btn primary" href="/about" target="_blank">Lihat Halaman About ↗</a>
      </div>

      <% if (typeof success !== 'undefined' && success) { %>
        <div class="notice" style="background:#dcfce7;color:#166534;border-color:#86efac;margin-bottom:20px;">
          ✅ <%= success %>
        </div>
      <% } %>

      <form class="admin-card" method="post" action="/admin/profile" enctype="multipart/form-data">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;">
          <div>
            <label>Nama Lengkap & Gelar *</label>
            <input name="name" value="<%= profile.name %>" required>
          </div>
          <div>
            <label>Bidang Keahlian / Title Baris 1</label>
            <input name="field" value="<%= profile.field %>" placeholder="Contoh: HR Generalist | Recruitment · Payroll · HR Operations · HRGA">
          </div>
        </div>

        <label>Tagline / Motto Profesional</label>
        <input name="tagline" value="<%= profile.tagline || '' %>" placeholder="Contoh: From Numbers to Human Impact.">

        <label>Biografi & Ringkasan Profil Profesional (About Me)</label>
        <textarea name="bio" style="min-height:160px;"><%= profile.bio || '' %></textarea>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:14px;">
          <div>
            <label>Email Kontak</label>
            <input name="email" value="<%= profile.email || '' %>">
          </div>
          <div>
            <label>URL Profil LinkedIn</label>
            <input name="linkedin" value="<%= profile.linkedin || '' %>">
          </div>
        </div>

        <div style="margin-top:20px;padding:20px;background:#fbfbfa;border:1px solid var(--line);border-radius:var(--radius);">
          <label style="margin-top:0;">Unggah / Ganti Berkas CV Resmi (.PDF, Maks 15MB)</label>
          <input type="file" name="cv" accept=".pdf">
          <% if (profile.cv_file) { %>
            <div style="margin-top:12px;display:flex;align-items:center;gap:14px;flex-wrap:wrap;">
              <span style="font-size:13px;color:var(--muted);">Berkas CV Aktif:</span>
              <a href="/uploads/<%= profile.cv_file %>" target="_blank" style="font-weight:700;color:var(--accent);font-size:13px;">
                📄 <%= profile.cv_file %>
              </a>
              <a class="small-btn" href="/cv" target="_blank">Test Download CV (/cv)</a>
            </div>
          <% } else { %>
            <p style="font-size:12.5px;color:#b91c1c;margin:8px 0 0;">Belum ada file CV yang diunggah.</p>
          <% } %>
        </div>

        <div style="margin-top:28px;">
          <button class="btn primary" style="padding:12px 28px;">Simpan Perubahan Profil</button>
        </div>
      </form>
    </main>
  </div>
</body>
</html>