<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Overview — Admin CMS</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="admin-body">
  <div class="admin-shell">
    <%- include('partials/admin-sidebar', { active: 'dashboard' }) %>

    <main class="admin-main">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;flex-wrap:wrap;gap:12px;">
        <div>
          <div class="kicker">Admin Control Center</div>
          <h1 style="margin:4px 0 0;">System Overview</h1>
        </div>
        <div style="display:flex;gap:10px;">
          <a class="btn" href="/admin/security">🔒 Security & Backup</a>
          <a class="btn primary" href="/" target="_blank">Lihat Website ↗</a>
        </div>
      </div>

      <!-- Quick Metrics Grid -->
      <div class="stats" style="grid-template-columns:repeat(auto-fit, minmax(160px, 1fr));gap:14px;margin-bottom:28px;">
        <div class="stat">
          Projects
          <strong><%= counts.projects %></strong>
          <small style="color:var(--muted);"><%= counts.publicProjects %> Public</small>
        </div>
        <div class="stat">
          Articles
          <strong><%= counts.articles %></strong>
          <small style="color:var(--muted);"><%= counts.publishedArticles %> Published</small>
        </div>
        <div class="stat">
          Certificates
          <strong><%= counts.certifications %></strong>
          <small style="color:var(--muted);"><%= counts.publicCerts %> Active</small>
        </div>
        <div class="stat">
          Experience
          <strong><%= counts.experiences %></strong>
          <small style="color:var(--muted);">Recorded</small>
        </div>
        <div class="stat">
          Skills
          <strong><%= counts.skills %></strong>
          <small style="color:var(--muted);">Categorized</small>
        </div>
        <div class="stat">
          Media Files
          <strong><%= counts.media %></strong>
          <small style="color:var(--muted);">Stored</small>
        </div>
      </div>

      <!-- Quick Actions Grid -->
      <div class="grid" style="grid-template-columns:repeat(auto-fit, minmax(320px, 1fr));gap:20px;margin-bottom:28px;">
        <div class="admin-card" style="margin:0;">
          <h2 style="font-size:18px;margin-bottom:12px;">⚡ Akses Cepat Kelola Konten</h2>
          <div style="display:flex;flex-direction:column;gap:8px;">
            <a href="/admin/projects/new" class="btn primary" style="text-align:left;font-size:13px;padding:9px 14px;">+ Tambah Project Showcase Baru</a>
            <a href="/admin/articles/new" class="btn" style="text-align:left;font-size:13px;padding:9px 14px;">+ Tulis Artikel Baru</a>
            <a href="/admin/certifications" class="btn" style="text-align:left;font-size:13px;padding:9px 14px;">+ Tambah Sertifikat & Dokumen</a>
            <a href="/admin/media" class="btn" style="text-align:left;font-size:13px;padding:9px 14px;">📁 Buka Media Library</a>
          </div>
        </div>

        <div class="admin-card" style="margin:0;">
          <h2 style="font-size:18px;margin-bottom:12px;">🖥️ Status Sistem & Penyimpanan</h2>
          <table style="font-size:13px;">
            <tr>
              <td style="padding:6px 0;color:var(--muted);">Database Engine</td>
              <td style="padding:6px 0;font-weight:700;text-align:right;">SQLite (WAL Mode, Persistent)</td>
            </tr>
            <tr>
              <td style="padding:6px 0;color:var(--muted);">Runtime Environment</td>
              <td style="padding:6px 0;font-weight:700;text-align:right;"><%= process.version %> (Node.js)</td>
            </tr>
            <tr>
              <td style="padding:6px 0;color:var(--muted);">File Storage Path</td>
              <td style="padding:6px 0;font-weight:700;text-align:right;"><code>uploads/</code></td>
            </tr>
            <tr>
              <td style="padding:6px 0;color:var(--muted);">Status Autentikasi</td>
              <td style="padding:6px 0;font-weight:700;text-align:right;color:#166534;">Active (Scrypt Hash)</td>
            </tr>
          </table>
          <div style="margin-top:14px;padding-top:12px;border-top:1px solid var(--line);display:flex;justify-content:space-between;align-items:center;">
            <span style="font-size:12px;color:var(--muted);">Backup Terakhir: Otomatis</span>
            <a href="/admin/security" class="small-btn">Kelola Backup →</a>
          </div>
        </div>
      </div>

      <!-- Navigation & Setup Summary -->
      <div class="admin-card">
        <h2 style="font-size:18px;margin-bottom:10px;">📋 Panduan Manajemen Website</h2>
        <p style="font-size:14px;color:var(--muted);line-height:1.6;margin-bottom:16px;">
          Seluruh elemen website portofolio Anda—mulai dari profil, pengalaman kerja, pendidikan, project showcase, artikel, sertifikasi, keahlian, media library, hingga navigasi dan SEO—dapat Anda perbarui langsung dari menu di sebelah kiri tanpa perlu menyentuh source code.
        </p>
        <div style="display:flex;gap:10px;flex-wrap:wrap;">
          <a class="small-btn" href="/admin/profile">Edit Profil & CV</a>
          <a class="small-btn" href="/admin/sections">Pengaturan Navigasi</a>
          <a class="small-btn" href="/admin/settings">Pengaturan SEO</a>
          <a class="small-btn" href="/admin/security">Ganti Password Admin</a>
        </div>
      </div>
    </main>
  </div>
</body>
</html>