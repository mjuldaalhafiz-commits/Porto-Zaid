<aside class="admin-side">
  <div style="padding-bottom:18px;border-bottom:1px solid rgba(255,255,255,0.1);margin-bottom:18px;">
    <h2 style="font-size:18px;margin:0 0 4px;color:#fff;">Admin CMS</h2>
    <p style="margin:0;font-size:12px;color:#8e8e93;"><%= typeof adminUser !== 'undefined' ? adminUser : 'Muhammad Julda Al Hafiz' %></p>
  </div>

  <nav style="display:flex;flex-direction:column;gap:3px;background:none;border:none;padding:0;position:static;">
    <div style="font-size:10px;font-weight:800;letter-spacing:0.12em;text-transform:uppercase;color:#636366;padding:8px 12px 4px;">Main Content</div>
    
    <a href="/admin" class="<%= active === 'dashboard' ? 'active' : '' %>">
      <span>📊 Overview</span>
    </a>
    <a href="/admin/profile" class="<%= active === 'profile' ? 'active' : '' %>">
      <span>👤 Profile & CV</span>
    </a>
    <a href="/admin/experience" class="<%= active === 'experience' ? 'active' : '' %>">
      <span>💼 Experience</span>
    </a>
    <a href="/admin/education" class="<%= active === 'education' ? 'active' : '' %>">
      <span>🎓 Education & Leadership</span>
    </a>
    <a href="/admin/projects" class="<%= active === 'projects' ? 'active' : '' %>">
      <span>🚀 Projects & Work Samples</span>
    </a>
    <a href="/admin/articles" class="<%= active === 'articles' ? 'active' : '' %>">
      <span>✍️ Articles & Blog</span>
    </a>
    <a href="/admin/certifications" class="<%= active === 'certifications' ? 'active' : '' %>">
      <span>📜 Certifications & Training</span>
    </a>
    <a href="/admin/skills" class="<%= active === 'skills' ? 'active' : '' %>">
      <span>🛠️ Skills & Tools</span>
    </a>

    <div style="font-size:10px;font-weight:800;letter-spacing:0.12em;text-transform:uppercase;color:#636366;padding:14px 12px 4px;">System & Settings</div>

    <a href="/admin/media" class="<%= active === 'media' ? 'active' : '' %>">
      <span>📁 Media & File Library</span>
    </a>
    <a href="/admin/sections" class="<%= active === 'sections' ? 'active' : '' %>">
      <span>🧭 Sections & Navigation</span>
    </a>
    <a href="/admin/settings" class="<%= active === 'settings' ? 'active' : '' %>">
      <span>⚙️ SEO & Website Settings</span>
    </a>
    <a href="/admin/security" class="<%= active === 'security' ? 'active' : '' %>">
      <span>🔒 Account, Security & Backup</span>
    </a>
  </nav>

  <div style="margin-top:24px;padding-top:16px;border-top:1px solid rgba(255,255,255,0.1);display:flex;flex-direction:column;gap:10px;">
    <!-- One-click Publish to Netlify -->
    <form method="post" action="/admin/publish-sync" style="margin:0;">
      <button type="submit" id="btn-publish-sync" style="width:100%;padding:10px 14px;font-size:13px;font-weight:700;color:#fff;background:#2e7d32;border:none;border-radius:6px;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;box-shadow:0 2px 6px rgba(46,125,50,0.3);transition:all 0.2s;" onclick="this.innerHTML='⏳ Sedang Mengunggah...'; this.style.opacity='0.7'; this.style.pointerEvents='none'; this.form.submit();">
        <span>🚀 Publish ke Netlify</span>
      </button>
    </form>

    <div id="publish-notification" style="display:none;padding:10px;border-radius:6px;font-size:12px;line-height:1.4;"></div>

    <script>
      (function() {
        const params = new URLSearchParams(window.location.search);
        const notif = document.getElementById('publish-notification');
        if (params.get('published') === '1') {
          notif.style.display = 'block';
          notif.style.background = 'rgba(46,125,50,0.15)';
          notif.style.color = '#4caf50';
          notif.style.border = '1px solid rgba(76,175,80,0.3)';
          notif.innerHTML = '✅ <strong>Berhasil dipublish!</strong> Perubahan telah dikirim ke GitHub & Netlify sedang update (~15 detik).';
        } else if (params.get('published') === 'error') {
          notif.style.display = 'block';
          notif.style.background = 'rgba(211,47,47,0.15)';
          notif.style.color = '#ef5350';
          notif.style.border = '1px solid rgba(239,83,80,0.3)';
          notif.innerHTML = '❌ <strong>Gagal mempublikasikan.</strong> Periksa koneksi internet atau coba lagi.';
        }
      })();
    </script>

    <a href="https://portozaid.netlify.app" target="_blank" style="font-size:12px;color:#0a84ff;padding:8px 12px;background:rgba(10,132,255,0.1);border-radius:6px;display:flex;align-items:center;justify-content:space-between;text-decoration:none;">
      <span>Lihat Website Netlify ↗</span>
    </a>
    <a href="/" target="_blank" style="font-size:12px;color:#aaa;padding:6px 12px;background:rgba(255,255,255,0.05);border-radius:6px;display:flex;align-items:center;justify-content:space-between;text-decoration:none;">
      <span>Preview Lokal (Port 3000) ↗</span>
    </a>
    <form method="post" action="/admin/logout" style="margin:0;">
      <button class="small-btn danger" style="width:100%;padding:8px 12px;text-align:center;">Logout</button>
    </form>
  </div>
</aside>
