<!doctype html><html lang="id"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= article ? "Edit Article" : "New Article" %> — Admin</title><link rel="stylesheet" href="/style.css"></head><body class="admin-body"><div class="admin-shell"><aside class="admin-side"><h2 style="font-family:Arial;font-size:22px">Admin CMS</h2><p style="color:#aaa">Muhammad Julda Al Hafiz</p><a href="/admin">Dashboard</a><a href="/admin/profile">Profile & CV</a><a href="/admin/articles">Articles</a><a href="/admin/projects">Projects</a><a href="/admin/experience">Experience</a><a href="/admin/certifications">Certifications</a><a href="/admin/education">Education</a><a href="/" target="_blank">View Public Website ↗</a><form method="post" action="/admin/logout"><button class="small-btn">Logout</button></form></aside><main class="admin-main"><h1><%= article ? "Edit Article" : "New Article" %></h1><form class="admin-card" method="post" action="/admin/articles/save" enctype="multipart/form-data"><input type="hidden" name="id" value="<%= article?.id||"" %>"><label>Title</label><input name="title" value="<%= article?.title||"" %>" required><label>Slug (optional)</label><input name="slug" value="<%= article?.slug||"" %>"><label>Category</label><input name="category" value="<%= article?.category||"" %>" placeholder="e.g. HR, Recruitment, Payroll"><label>Excerpt</label><textarea name="excerpt" style="min-height:90px"><%= article?.excerpt||"" %></textarea><label>Content</label><textarea name="content" required><%= article?.content||"" %></textarea><label>Cover Image</label><input type="file" name="cover" accept="image/*"><% if (article?.cover) { %><p class="muted" style="margin-top:6px">Cover saat ini: <a href="/uploads/<%= article.cover %>" target="_blank"><%= article.cover %></a></p><% } %><label>Status</label><select name="status"><option value="draft" <%= article?.status!=="published"?"selected":"" %>>Draft</option><option value="published" <%= article?.status==="published"?"selected":"" %>>Published</option></select><div style="display:flex;gap:10px;margin-top:20px"><button class="btn primary">Save Article</button><a class="btn" href="/admin/articles">Cancel</a></div></form></main></div></body></html>