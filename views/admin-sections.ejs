<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Sections & Navigation — Admin CMS</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="admin-body">
  <div class="admin-shell">
    <%- include('partials/admin-sidebar', { active: 'sections' }) %>

    <main class="admin-main">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;flex-wrap:wrap;gap:12px;">
        <div>
          <h1 style="margin:0;">Sections & Navigation</h1>
          <p class="muted" style="margin:4px 0 0;">Atur menu navigasi bar website dan visibilitas setiap section pada halaman beranda.</p>
        </div>
        <a class="btn primary" href="/" target="_blank">Lihat Tampilan Website ↗</a>
      </div>

      <!-- Navigation Items Manager -->
      <div class="admin-card">
        <h2>🧭 Menu Navigasi Website (Navbar Links)</h2>
        <p class="muted" style="margin-top:-6px;margin-bottom:16px;font-size:13.5px;">
          Tentukan tautan menu yang tampil di header website publik. Anda dapat mengubah label, URL, urutan, atau menyembunyikan menu tertentu.
        </p>

        <table>
          <thead>
            <tr>
              <th style="width:60px;text-align:center;">Urutan</th>
              <th>Label Menu</th>
              <th>Target URL</th>
              <th style="width:100px;text-align:center;">Status</th>
              <th style="width:140px;text-align:right;">Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% navItems.forEach(item => { %>
              <tr>
                <form method="post" action="/admin/sections/nav/update">
                  <input type="hidden" name="id" value="<%= item.id %>">
                  <td style="text-align:center;">
                    <input type="number" name="display_order" value="<%= item.display_order %>" style="width:60px;text-align:center;padding:6px;">
                  </td>
                  <td>
                    <input type="text" name="label" value="<%= item.label %>" style="padding:6px 10px;" required>
                  </td>
                  <td>
                    <input type="text" name="url" value="<%= item.url %>" style="padding:6px 10px;" required>
                  </td>
                  <td style="text-align:center;">
                    <select name="is_active" style="padding:6px;">
                      <option value="1" <%= item.is_active == 1 ? 'selected' : '' %>>Aktif</option>
                      <option value="0" <%= item.is_active == 0 ? 'selected' : '' %>>Hidden</option>
                    </select>
                  </td>
                  <td style="text-align:right;">
                    <button class="small-btn">Save</button>
                  </td>
                </form>
              </tr>
            <% }) %>
          </tbody>
        </table>

        <!-- Add New Nav Item Form -->
        <div style="margin-top:20px;padding-top:16px;border-top:1px solid var(--line);">
          <h3 style="font-size:15px;margin-bottom:10px;">+ Tambah Menu Navigasi Baru</h3>
          <form method="post" action="/admin/sections/nav/add" style="display:flex;gap:12px;align-items:flex-end;flex-wrap:wrap;">
            <div style="flex-grow:1;min-width:180px;">
              <label style="margin-top:0;">Label Menu</label>
              <input name="label" placeholder="e.g. CV Download" required>
            </div>
            <div style="flex-grow:1;min-width:180px;">
              <label style="margin-top:0;">Target URL</label>
              <input name="url" placeholder="e.g. /cv atau https://..." required>
            </div>
            <div style="width:90px;">
              <label style="margin-top:0;">Urutan</label>
              <input type="number" name="display_order" value="<%= navItems.length + 1 %>" style="text-align:center;">
            </div>
            <button class="btn primary" style="padding:11px 18px;">Tambah Menu</button>
          </form>
        </div>
      </div>

      <!-- Homepage Sections Visibility Manager -->
      <div class="admin-card">
        <h2>📑 Pengaturan Section Halaman Beranda (Homepage)</h2>
        <p class="muted" style="margin-top:-6px;margin-bottom:16px;font-size:13.5px;">
          Nyalakan atau matikan section yang ingin ditampilkan di halaman depan tanpa mengedit template kode.
        </p>

        <table>
          <thead>
            <tr>
              <th>Nama Section</th>
              <th>Judul / Keterangan</th>
              <th style="width:80px;text-align:center;">Urutan</th>
              <th style="width:130px;text-align:center;">Visibilitas</th>
              <th style="width:100px;text-align:right;">Simpan</th>
            </tr>
          </thead>
          <tbody>
            <% sections.forEach(sec => { %>
              <tr>
                <form method="post" action="/admin/sections/update">
                  <input type="hidden" name="section_key" value="<%= sec.section_key %>">
                  <td>
                    <strong><%= sec.section_key.toUpperCase() %></strong>
                  </td>
                  <td>
                    <input type="text" name="title" value="<%= sec.title %>" style="padding:6px 10px;margin-bottom:4px;" placeholder="Judul Section">
                    <input type="text" name="subtitle" value="<%= sec.subtitle || '' %>" style="padding:4px 10px;font-size:12px;color:var(--muted);" placeholder="Subjudul / Keterangan">
                  </td>
                  <td style="text-align:center;">
                    <input type="number" name="display_order" value="<%= sec.display_order %>" style="width:60px;text-align:center;padding:6px;">
                  </td>
                  <td style="text-align:center;">
                    <select name="is_visible" style="padding:6px;">
                      <option value="1" <%= sec.is_visible == 1 ? 'selected' : '' %>>🟢 Tampilkan</option>
                      <option value="0" <%= sec.is_visible == 0 ? 'selected' : '' %>>🟡 Sembunyikan</option>
                    </select>
                  </td>
                  <td style="text-align:right;">
                    <button class="small-btn">Save</button>
                  </td>
                </form>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </main>
  </div>
</body>
</html>
