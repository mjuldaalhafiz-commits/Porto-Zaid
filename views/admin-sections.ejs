<!doctype html>
<html lang="id">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Sections, Copywriting & Navigation — Admin CMS</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="admin-body">
  <div class="admin-shell">
    <%- include('partials/admin-sidebar', { active: 'sections' }) %>

    <main class="admin-main">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:24px;flex-wrap:wrap;gap:12px;">
        <div>
          <h1 style="margin:0;">Sections, Copywriting & Navigation</h1>
          <p class="muted" style="margin:4px 0 0;">Ubah materi copywriting, headline, subjudul, kartu pencapaian, dan menu navigasi website.</p>
        </div>
        <a class="btn primary" href="/" target="_blank">Lihat Tampilan Website ↗</a>
      </div>

      <% if (typeof success !== 'undefined' && success) { %>
        <div class="notice" style="background:#dcfce7;color:#166534;border-color:#86efac;margin-bottom:20px;padding:12px 18px;border-radius:var(--radius);border:1px solid #86efac;">
          ✅ Perubahan berhasil disimpan ke database.
        </div>
      <% } %>

      <!-- SECTION COPYWRITING MANAGER -->
      <div class="admin-card" style="margin-bottom:26px;">
        <h2>📑 Pengaturan Copywriting & Headline Section Beranda</h2>
        <p class="muted" style="margin-top:-6px;margin-bottom:16px;font-size:13.5px;">
          Setiap teks di beranda (kicker atas, headline utama, tagline, dan narasi deskripsi) dapat diubah langsung di sini.
        </p>

        <table>
          <thead>
            <tr>
              <th style="width:110px;">Section</th>
              <th>Materi Copywriting (Kicker, Judul, Subjudul & Isi Teks)</th>
              <th style="width:70px;text-align:center;">Urutan</th>
              <th style="width:125px;text-align:center;">Status</th>
              <th style="width:90px;text-align:right;">Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% sections.forEach(sec => { %>
              <tr style="vertical-align:top;">
                <form method="post" action="/admin/sections/update">
                  <input type="hidden" name="section_key" value="<%= sec.section_key %>">
                  <td>
                    <span style="font-weight:700;color:var(--ink);background:#f2f1ed;padding:4px 8px;border-radius:4px;font-size:11.5px;display:inline-block;margin-top:6px;">
                      <%= sec.section_key.toUpperCase() %>
                    </span>
                  </td>
                  <td>
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:6px;">
                      <div>
                        <label style="font-size:11px;color:var(--muted);margin:0 0 2px;display:block;">Kicker / Label Atas (Huruf Kapital)</label>
                        <input type="text" name="kicker" value="<%= sec.kicker || '' %>" style="padding:6px 10px;font-size:12.5px;" placeholder="Contoh: PORTFOLIO HIGHLIGHTS">
                      </div>
                      <div>
                        <label style="font-size:11px;color:var(--muted);margin:0 0 2px;display:block;">Subjudul / Tagline / Keterangan</label>
                        <input type="text" name="subtitle" value="<%= sec.subtitle || '' %>" style="padding:6px 10px;font-size:12.5px;" placeholder="Contoh: From Numbers to Human Impact.">
                      </div>
                    </div>

                    <label style="font-size:11px;color:var(--muted);margin:0 0 2px;display:block;">Judul Headline Utama</label>
                    <input type="text" name="title" value="<%= sec.title %>" style="padding:6px 10px;font-weight:600;margin-bottom:6px;" placeholder="Judul Section">

                    <% if (['hero', 'cta'].includes(sec.section_key)) { %>
                      <label style="font-size:11px;color:var(--muted);margin:0 0 2px;display:block;">
                        <%= sec.section_key === 'hero' ? 'Paragraf Deskripsi Profil Utama (Lead Text)' : 'Teks Penjelas Banner Ajakan Kerja Sama' %>
                      </label>
                      <textarea name="content" style="min-height:75px;font-size:13px;padding:8px 10px;line-height:1.5;"><%= sec.content || '' %></textarea>
                    <% } %>
                  </td>
                  <td style="text-align:center;">
                    <input type="number" name="display_order" value="<%= sec.display_order %>" style="width:55px;text-align:center;padding:6px;margin-top:6px;">
                  </td>
                  <td style="text-align:center;">
                    <select name="is_visible" style="padding:6px;margin-top:6px;font-size:12px;">
                      <option value="1" <%= sec.is_visible == 1 ? 'selected' : '' %>>🟢 Tampilkan</option>
                      <option value="0" <%= sec.is_visible == 0 ? 'selected' : '' %>>🟡 Sembunyikan</option>
                    </select>
                  </td>
                  <td style="text-align:right;">
                    <button class="small-btn primary" style="margin-top:6px;padding:6px 14px;">Simpan</button>
                  </td>
                </form>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <!-- HIGHLIGHTS / PENCAPAIAN UTAMA CARDS MANAGER -->
      <div class="admin-card" style="margin-bottom:26px;">
        <h2>📊 Kartu Pencapaian Utama (Section Highlights)</h2>
        <p class="muted" style="margin-top:-6px;margin-bottom:16px;font-size:13.5px;">
          Kelola 4 kartu statistik pencapaian operasional di beranda (misal: "45+ Posisi Terisi", "Sistem Payroll 100+ Karyawan", dll).
        </p>

        <table>
          <thead>
            <tr>
              <th style="width:140px;">Kategori / Meta</th>
              <th style="width:200px;">Judul Angka / Highlight</th>
              <th>Deskripsi / Penjelasan Pencapaian</th>
              <th style="width:60px;text-align:center;">Urutan</th>
              <th style="width:120px;text-align:right;">Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% (typeof highlights !== 'undefined' ? highlights : []).forEach(hl => { %>
              <tr style="vertical-align:top;">
                <form method="post" action="/admin/highlights/save">
                  <input type="hidden" name="id" value="<%= hl.id %>">
                  <td>
                    <input type="text" name="meta" value="<%= hl.meta %>" style="padding:6px 8px;font-size:12px;font-weight:700;" placeholder="RECRUITMENT" required>
                  </td>
                  <td>
                    <input type="text" name="title" value="<%= hl.title %>" style="padding:6px 8px;font-size:13px;font-weight:600;" placeholder="45+ Posisi Terisi" required>
                  </td>
                  <td>
                    <textarea name="description" style="min-height:60px;font-size:12.5px;padding:6px 8px;line-height:1.4;"><%= hl.description %></textarea>
                  </td>
                  <td style="text-align:center;">
                    <input type="number" name="display_order" value="<%= hl.display_order %>" style="width:50px;text-align:center;padding:6px;">
                  </td>
                  <td style="text-align:right;">
                    <button class="small-btn primary" style="margin-bottom:4px;">Save</button>
                </form>
                    <form method="post" action="/admin/highlights/<%= hl.id %>/delete" style="display:inline;" onsubmit="return confirm('Hapus kartu pencapaian ini?');">
                      <button class="small-btn danger">Del</button>
                    </form>
                  </td>
              </tr>
            <% }) %>
          </tbody>
        </table>

        <!-- Add Highlight Form -->
        <div style="margin-top:20px;padding-top:16px;border-top:1px solid var(--line);">
          <h3 style="font-size:14.5px;margin-bottom:10px;">+ Tambah Kartu Pencapaian Baru</h3>
          <form method="post" action="/admin/highlights/save" style="display:grid;grid-template-columns:1fr 1fr 2fr 80px auto;gap:10px;align-items:flex-end;">
            <div>
              <label style="margin:0 0 2px;font-size:11.5px;">Kategori / Meta</label>
              <input name="meta" placeholder="e.g. OPERATIONS" required style="padding:8px;">
            </div>
            <div>
              <label style="margin:0 0 2px;font-size:11.5px;">Judul Pencapaian</label>
              <input name="title" placeholder="e.g. Efisiensi 30%" required style="padding:8px;">
            </div>
            <div>
              <label style="margin:0 0 2px;font-size:11.5px;">Deskripsi Singkat</label>
              <input name="description" placeholder="Penjelasan hasil nyata..." required style="padding:8px;">
            </div>
            <div>
              <label style="margin:0 0 2px;font-size:11.5px;">Urutan</label>
              <input type="number" name="display_order" value="5" style="padding:8px;text-align:center;">
            </div>
            <button class="btn primary" style="padding:9px 16px;">Tambah</button>
          </form>
        </div>
      </div>

      <!-- NAVBAR LINKS MANAGER -->
      <div class="admin-card">
        <h2>🧭 Menu Navigasi Header Website (Navbar Links)</h2>
        <p class="muted" style="margin-top:-6px;margin-bottom:16px;font-size:13.5px;">
          Tentukan tautan menu yang tampil di bar atas website.
        </p>

        <table>
          <thead>
            <tr>
              <th style="width:60px;text-align:center;">Urutan</th>
              <th>Label Menu</th>
              <th>Target URL</th>
              <th style="width:100px;text-align:center;">Status</th>
              <th style="width:100px;text-align:right;">Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% navItems.forEach(item => { %>
              <tr>
                <form method="post" action="/admin/sections/nav/update">
                  <input type="hidden" name="id" value="<%= item.id %>">
                  <td style="text-align:center;">
                    <input type="number" name="display_order" value="<%= item.display_order %>" style="width:55px;text-align:center;padding:6px;">
                  </td>
                  <td>
                    <input type="text" name="label" value="<%= item.label %>" style="padding:6px 10px;" required>
                  </td>
                  <td>
                    <input type="text" name="url" value="<%= item.url %>" style="padding:6px 10px;" required>
                  </td>
                  <td style="text-align:center;">
                    <select name="is_active" style="padding:6px;">
                      <option value="1" <%= item.is_active == 1 ? 'selected' : '' %>>Aktif</option>
                      <option value="0" <%= item.is_active == 0 ? 'selected' : '' %>>Hidden</option>
                    </select>
                  </td>
                  <td style="text-align:right;">
                    <button class="small-btn primary">Save</button>
                  </td>
                </form>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </main>
  </div>
</body>
</html>
